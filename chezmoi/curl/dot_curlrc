# Disguise as FF on macOS
user-agent = "Mozilla/5.0 (Macintosh; Intel Mac OS X 10.15; rv:128.0) Gecko/20100101 Firefox/128.0"

# When following a redirect, automatically set the previous URL as referer.
referer = ";auto"

# Retrying
connect-timeout = 60
max-time 120
retry 3
retry-delay 0
retry-max-time 360