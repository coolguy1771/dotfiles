root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,jsonc,toml,tf,tfvars,hcl}]
indent_size = 2

[*.{js,jsx,ts,tsx,vue,svelte,css,scss,html}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.go]
indent_style = tab

[*.{sh,bash,zsh}]
indent_size = 4

[*.py]
indent_size = 4

[*.{rb,rake}]
indent_size = 2
