{{- $personal := false -}}{{/* true if this is a personal machine */}}
{{- $personal = promptBool "personal" -}}
{{- $workSigningKey := "" -}}
{{- if not $personal -}}
{{- $workSigningKey = promptString "work SSH signing key (ssh-ed25519 ...)" -}}
{{- end -}}

format: yaml

# Exclude run scripts from diff/status so output stays focused on dotfiles
diff:
  exclude:
    - scripts
status:
  exclude:
    - scripts

data:
  name: "Tyler Witlin"
  personal: {{ $personal | quote }}
  workSigningKey: {{ $workSigningKey | quote }}
