# Readline (bash, python REPL, etc.) - vi mode + cursor shape (beam insert, block cmd)
set editing-mode vi
set show-mode-in-prompt on
set vi-cmd-mode-string "\1\033[1;33m\2cmd\1\033[0m\2 \1\033[2 q\2"
set vi-ins-mode-string "\1\033[1;32m\2ins\1\033[0m\2 \1\033[6 q\2"

# Completion
set completion-ignore-case on
set show-all-if-ambiguous on
set completion-prefix-display-length 2

# History search with up/down
"\e[A": history-search-backward
"\e[B": history-search-forward

# No bell
set bell-style none
